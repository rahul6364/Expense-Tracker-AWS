# Dependencies
node_modules/
**/node_modules/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# Build output
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / cache
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo
.eslintcache

# Test coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# Docker (local overrides only)
docker-compose.override.yml
.docker/

# AWS / cloud credentials
.aws/
*.pem
*.ppk

# Terraform / IaC (if added later)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Secrets & keys
*.key
*.crt
credentials.json
secrets.json

# Temporary files
tmp/
temp/
*.tmp

# Optional: uncomment to ignore screenshots until you add them
# docs/images/*.png
# docs/images/*.jpg
# docs/images/*.jpeg
# !docs/images/.gitkeep
